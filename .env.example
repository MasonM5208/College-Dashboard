# ---------------------------------------------------------------------------
# Example of the file that must exist at:
#   /home/mason/College-Dashboard/.env
#
# Copy it, fill in the real values, and never commit the result. The real .env
# is listed in .gitignore.
#
#   cp .env.example .env
#
# WHAT THIS FILE IS FOR — and what it is NOT for.
#
# Docker Compose reads THIS file to fill in the ${...} placeholders inside
# docker-compose.yml. That substitution happens on the host, before the
# container starts, which is why the tailnet IP has to live here.
#
# Application SECRETS do NOT go in this file. They live in a separate
# root-owned file at /etc/college-dashboard/env, described in
# ops/secrets.env.example and docs/SECRETS.md. Compose passes that second file
# into the container but cannot use it for ${...} substitution — the two files
# are not interchangeable.
# ---------------------------------------------------------------------------

# The VPS's Tailscale IP address. Tailscale gives every machine on your private
# network an address starting with 100. Find yours by running this on the VPS:
#
#   tailscale ip -4
#
# This is the ONLY address the dashboard will listen on. Nothing on the public
# internet can reach it. Replace the placeholder below with the real address —
# the letters are not valid in an IP address and Compose will refuse to start.
TAILNET_BIND_IP=100.x.y.z

# Timezone, used for dates shown in the interface and for when the nightly
# backup runs. Full list of valid names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Indiana/Indianapolis
