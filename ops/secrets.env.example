# ---------------------------------------------------------------------------
# Example of the SECRETS file, which lives OUTSIDE this repository at:
#   /etc/college-dashboard/env
#
# Owned by root, permissions 600 (only root can read it). docs/SETUP.md walks
# through creating it; docs/SECRETS.md explains how to rotate each value.
#
# NEVER copy real values back into the repository — not into a file, not into a
# comment, not into a commit message. If you paste a real key anywhere in
# College-Dashboard/, treat it as leaked and rotate it.
#
# Values are added milestone by milestone. A variable that is not needed yet can
# be left out entirely; the application says which one is missing if it needs one.
# ---------------------------------------------------------------------------


# --- Backups (needed now, in M0) -------------------------------------------

# The PUBLIC half of your age encryption key pair. age (pronounced "aghe") is a
# file encryption tool. A public key can only LOCK backups, never unlock them,
# which is why it is safe to keep on the server. It starts with "age1".
#
# The matching PRIVATE key stays on your MacBook and in one offline copy. It
# must never be placed on the VPS — if it were, anyone who broke into the VPS
# could read every backup.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_YOUR_PUBLIC_KEY

# Backblaze B2 is the off-site storage the nightly backup is copied to. These
# two values come from creating an "application key" in the B2 web interface.
# The second one is shown exactly once, at creation.
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=REPLACE_WITH_B2_KEY_ID
RCLONE_CONFIG_B2_KEY=REPLACE_WITH_B2_APPLICATION_KEY

# Name of the B2 bucket backups are copied into.
BACKUP_B2_BUCKET=REPLACE_WITH_BUCKET_NAME


# --- Canvas (needed in M1, not yet) ----------------------------------------

# The Canvas calendar feed address. Treat this like a password: it contains a
# token, and anyone holding the address can read your entire class schedule.
# CANVAS_ICS_URL=


# --- Reminders ---------------------------------------------------------------

# Your Apple ID, and an APP-SPECIFIC password from account.apple.com — not your
# Apple ID password, which will not work. SETUP.md Section 16.
# CALDAV_URL=
# CALDAV_USERNAME=
# CALDAV_PASSWORD=


# --- Document archive --------------------------------------------------------

# Shared secret the iPhone Shortcut sends so the ingest endpoint knows it is you.
# Make one with:  openssl rand -hex 32
# Without it, saving from the phone is refused rather than allowed. SETUP.md
# Section 17.
# INGEST_TOKEN=


# --- Chat --------------------------------------------------------------------

# From console.anthropic.com. Billed to you, so set a spending limit there too.
# CLAUDE_API_KEY=
